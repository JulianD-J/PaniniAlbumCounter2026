rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'juliand.colediverti@gmail.com';
    }

    // --- Global Settings ---
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Validation helper for user profile
      function isValidUser(data) {
        return (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128) &&
               (data.get('trialUsed', false) is bool) &&
               (data.get('updatedAt', request.time) == request.time);
      }

      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if (isValidUser(incoming()) && (
        isOwner(userId) && (
          // Business logic transitions for owners
          (resource.data.get('trialUsed', false) == false || incoming().get('trialUsed', false) == true) &&
          (!('trialStartDate' in resource.data) || resource.data.trialStartDate == incoming().trialStartDate)
        ) || (
          // Allow friends to increment swap counts
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)) &&
          incoming().diff(resource.data).affectedKeys().hasOnly(['stats', 'updatedAt']) &&
          incoming().get('stats', {}).diff(resource.data.get('stats', {})).affectedKeys().hasOnly(['completedSwaps'])
        )
      )) || isAdmin();

      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Messages & Swaps ---
    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      
      allow create: if isSignedIn() && 
        isValidId(messageId) &&
        incoming().from == request.auth.uid &&
        incoming().status == 'pending' &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(incoming().to));
        
      allow update: if isSignedIn() && 
        (resource.data.to == request.auth.uid) && 
        incoming().diff(resource.data).affectedKeys().hasOnly(['status']) &&
        incoming().status in ['pending', 'completed'];
    }

    // --- Albums ---
    match /albums/{albumId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(resource.data.userId)/friends/$(request.auth.uid))
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Anti-Fraud Collections ---
    match /dispositivos_registrados/{deviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && 
        incoming().uid == request.auth.uid &&
        (incoming().isAnonymous is bool) &&
        (incoming().get('registeredAt', request.time) == request.time || incoming().get('registeredAt', request.time) is string);
      allow delete: if false;
    }

    match /dispositivos_prueba_gratis/{deviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        incoming().uid == request.auth.uid &&
        (incoming().prueba_utilizada == true) &&
        (incoming().get('activatedAt', request.time) == request.time || incoming().get('activatedAt', request.time) is string);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
