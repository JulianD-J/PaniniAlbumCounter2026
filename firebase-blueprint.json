{
  "entities": {
    "Album": {
      "title": "Album",
      "description": "A Colediverti album owned by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The owner of the album." },
        "name": { "type": "string", "description": "Name of the album (e.g., 'Mi Álbum')." },
        "inventory": {
          "type": "object",
          "description": "Map of sticker codes to inventory items containing quantity and isConseguida."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "createdAt", "updatedAt"]
    },
    "Sticker": {
      "title": "Sticker",
      "description": "A sticker's status within an album.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["missing", "obtained", "repeated"] },
        "count": { "type": "number", "description": "Number of pieces if repeated." }
      },
      "required": ["status", "count"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile data for a user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "normalizedName": { "type": "string", "description": "Lowercase name without accents for search." },
        "isPremium": { "type": "boolean", "description": "Whether the user has purchased premium access." },
        "premiumUntil": { "type": "string", "format": "date-time", "description": "Expiration date for premium (if applicable)." },
        "purchaseToken": { "type": "string", "description": "Last valid Google Play purchase token." },
        "trialStartDate": { "type": "string", "format": "date-time", "description": "When the 7-day trial started." },
        "trialUsed": { "type": "boolean", "description": "Whether the user already used their one-time trial." },
        "playGamesLinked": { "type": "boolean", "description": "Whether Play Games account is linked." },
        "trialExportCount": { "type": "number", "description": "Number of exports during trial (max 10)." },
        "badges": { "type": "array", "items": { "type": "string" } },
        "stats": {
          "type": "object",
          "properties": {
            "completedSwaps": { "type": "number" },
            "completionPercentage": { "type": "number" }
          }
        }
      }
    },
    "DispositivoRegistrado": {
      "title": "DispositivoRegistrado",
      "description": "Mapping of device ID to anonymous user UID for fraud prevention.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "isAnonymous"]
    },
    "DispositivoPruebaGratis": {
      "title": "DispositivoPruebaGratis",
      "description": "Record of devices that have used the free 1-week trial.",
      "type": "object",
      "properties": {
        "prueba_utilizada": { "type": "boolean" },
        "uid": { "type": "string" },
        "activatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prueba_utilizada", "uid"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "dispositivos_registrados/{deviceId}": {
      "schema": "DispositivoRegistrado",
      "description": "Collection of devices registered anonymously for anti-fraud tracking."
    },
    "dispositivos_prueba_gratis/{deviceId}": {
      "schema": "DispositivoPruebaGratis",
      "description": "Global list tracking device IDs that consumed the free trial."
    },
    "albums/{albumId}": {
      "schema": "Album",
      "description": "User albums."
    },
    "users/{userId}/friends/{friendId}": {
      "schema": { "type": "object", "properties": { "addedAt": { "type": "string", "format": "date-time" } } },
      "description": "User's favorite friends."
    },
    "messages/{messageId}": {
      "schema": { 
        "type": "object", 
        "properties": { 
          "from": { "type": "string" },
          "to": { "type": "string" },
          "text": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "completed"] },
          "type": { "type": "string" },
          "give": { "type": "array", "items": { "type": "string" } },
          "get": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Direct messages and swap requests between friends."
    }
  }
}
